{
  "name": "@arcanetech/privacy-sdk-stellar",
  "version": "0.6.0",
  "description": "Stellar preset for the Arcane privacy SDK",
  "type": "module",
  "browser": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./transact": {
      "types": "./dist/transact/index.d.ts",
      "import": "./dist/transact/index.js",
      "default": "./dist/transact/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js",
      "default": "./dist/state/index.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "scripts": {
    "bindings:generate": "soroban contract bindings typescript --rpc-url https://soroban-testnet.stellar.org --network-passphrase \"Test SDF Network ; September 2015\" --contract-id CD56SAQXVPM3MWTTNVDBDVUEQC6DPRIIYHP67C3ICH6JGMLJSWWUFUON --output-dir ./generated/contract --overwrite && soroban contract bindings typescript --rpc-url https://soroban-testnet.stellar.org --network-passphrase \"Test SDF Network ; September 2015\" --contract-id CCO5QRTS5HFVPR356FFC4NI62IMBQNDGMOAXR4K5UVTV3YMRWDZGKXGC --output-dir ./generated/registry --overwrite",
    "bindings:build": "npm run build --prefix generated/contract && npm run build --prefix generated/registry",
    "prebuild": "npm run bindings:build",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@arcanetech/privacy-sdk-core": "0.3.1",
    "@arcanetech/stellar-privacy-pool-zk-sdk": "^0.11.1-rc.1",
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "^6.0.3",
    "contract": "file:./generated/contract",
    "registry": "file:./generated/registry",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@arcanetech/privacy-sdk-state-memory": "0.2.3",
    "@arcanetech/privacy-sdk-state-redux": "0.2.3",
    "@reduxjs/toolkit": "^2.6.1"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanetechhq/privacy-layer-confidential-sdk.git",
    "directory": "packages/stellar"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}