{
  "name": "@arcanetech/privacy-sdk-state-memory",
  "version": "1.0.0",
  "description": "In-memory state bridge adapter for the Arcane privacy SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@arcanetech/privacy-sdk-core": "1.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanetechhq/privacy-layer-confidential-sdk.git",
    "directory": "packages/state/memory"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}