{
  "name": "@arcanetech/privacy-sdk-blend",
  "version": "0.1.0",
  "description": "Blend Interest Deposit placement for the Arcane privacy SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanetechhq/privacy-layer-confidential-sdk.git",
    "directory": "packages/integrations/blend"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@arcanetech/privacy-sdk-core": "0.5.0",
    "@arcanetech/privacy-sdk-stellar": "0.8.4",
    "@stellar/stellar-sdk": "^16.0.1",
    "buffer": "^6.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@arcanetech/privacy-sdk-state-memory": "0.2.5"
  }
}
