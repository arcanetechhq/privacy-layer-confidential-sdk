{
  "name": "@arcanetech/privacy-sdk-data-layer",
  "version": "1.0.0",
  "description": "Private-data HTTP client that checks caller-supplied schemas before returning records or completions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcanetechhq/privacy-layer-confidential-sdk.git",
    "directory": "packages/data-layer"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@arcanetech/privacy-sdk-core": "1.0.1",
    "zod": "^3.24.2"
  }
}
